{
  "name": "youtube-video-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Programmatic motion graphics with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render src/index.ts Showcase out/Showcase.mp4",
    "still": "remotion still src/index.ts Showcase out/Showcase.png --frame=60",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade",
    "new": "node scripts/new-composition.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/google-fonts": "4.0.533",
    "@remotion/media-utils": "4.0.533",
    "@remotion/noise": "4.0.533",
    "@remotion/shapes": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "lucide-react": "^1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
