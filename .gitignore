# Media and Generated Artifacts (DO NOT PUSH TO GITHUB)
# Only the three media folders exist: audio/, images/, videos/
audio/*
images/*
videos/*
!audio/.gitkeep
!images/.gitkeep
!videos/.gitkeep
outputs/

