outputs/

# YouTube media folders: keep the folders, ignore their contents
text_input/**
!text_input/.gitkeep
audio_input/**
!audio_input/.gitkeep
video_input/**
!video_input/.gitkeep
video_output/**
!video_output/.gitkeep
